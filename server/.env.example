NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false
TIDB_HOST=your-cluster.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_user
TIDB_PASSWORD=replace_with_secret
TIDB_DATABASE=fresh_farm
# Same Firebase project id as NEXT_PUBLIC_FIREBASE_PROJECT_ID. Required for Google sign-in.
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: store a Firebase service-account JSON in a secret manager, not this file or source
# control. When omitted, the API verifies ID tokens with Google's public certificates.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional bootstrap/fallback Argon2id hash. Passwords and PINs are normally
# stored hashed in the admins table by scripts/create-admin.js or the first-time
# setup screen at /admin/login. Never use a default or plain password.
ADMIN_PASSWORD_HASH=
# Generate a cryptographically random value with at least 32 bytes.
SESSION_SECRET=
# Razorpay checkout keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_secret
# Webhook secret from the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Order alerts and email receipts (optional).
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_WHATSAPP=
GMAIL_USER=
GMAIL_APP_PASSWORD=
