# Public Firebase web-app identity. Both values are safe to ship to browsers.
# Get them from Firebase Console -> Project settings -> General -> Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional. Defaults to <projectId>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Express API origin used by the /api/backend rewrite.
API_INTERNAL_URL=http://localhost:4000

# Optional server-side settings for the temporary first-time admin sign-in.
# Store Argon2id HASHES only (generate with argon2id), never plaintext. These
# belong in server/.env, not in browser-facing configuration. Both hashes are
# required; once the owner sets a personal password and PIN these stop working.
# ADMIN_DEFAULT_PASSWORD_HASH=$argon2id$...
# ADMIN_DEFAULT_PIN_HASH=$argon2id$...
# Optional identity used to create the first admin row on first sign-in.
# ADMIN_DEFAULT_EMAIL=owner@freshfarm.local
# ADMIN_DEFAULT_NAME=Farm Owner
